{
  "name": "omniview",
  "productName": "OmniView",
  "version": "1.1.0",
  "description": "Vizualizator universal de imagini si video pentru Windows: HEIC, HEIF, AVIF, HEVC, TIFF si multe altele",
  "main": "src/main.js",
  "author": "kebulann",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "heic-decode": "^2.0.0",
    "utif2": "^4.1.0"
  },
  "build": {
    "appId": "com.kebulann.omniview",
    "productName": "OmniView",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "fileAssociations": [
        { "ext": "heic", "name": "HEIC Image", "role": "Viewer" },
        { "ext": "heif", "name": "HEIF Image", "role": "Viewer" },
        { "ext": "avif", "name": "AVIF Image", "role": "Viewer" },
        { "ext": "tif", "name": "TIFF Image", "role": "Viewer" },
        { "ext": "tiff", "name": "TIFF Image", "role": "Viewer" },
        { "ext": "webp", "name": "WebP Image", "role": "Viewer" },
        { "ext": "jpg", "name": "JPEG Image", "role": "Viewer" },
        { "ext": "jpeg", "name": "JPEG Image", "role": "Viewer" },
        { "ext": "jfif", "name": "JPEG Image", "role": "Viewer" },
        { "ext": "png", "name": "PNG Image", "role": "Viewer" },
        { "ext": "apng", "name": "Animated PNG Image", "role": "Viewer" },
        { "ext": "gif", "name": "GIF Image", "role": "Viewer" },
        { "ext": "bmp", "name": "Bitmap Image", "role": "Viewer" },
        { "ext": "svg", "name": "SVG Image", "role": "Viewer" },
        { "ext": "ico", "name": "Icon Image", "role": "Viewer" },
        { "ext": "hevc", "name": "HEVC Video", "role": "Viewer" },
        { "ext": "h265", "name": "H.265 Video", "role": "Viewer" },
        { "ext": "265", "name": "H.265 Video", "role": "Viewer" },
        { "ext": "mp4", "name": "MP4 Video", "role": "Viewer" },
        { "ext": "m4v", "name": "M4V Video", "role": "Viewer" },
        { "ext": "mov", "name": "QuickTime Video", "role": "Viewer" },
        { "ext": "mkv", "name": "Matroska Video", "role": "Viewer" },
        { "ext": "webm", "name": "WebM Video", "role": "Viewer" },
        { "ext": "avi", "name": "AVI Video", "role": "Viewer" },
        { "ext": "wmv", "name": "Windows Media Video", "role": "Viewer" },
        { "ext": "3gp", "name": "3GP Video", "role": "Viewer" },
        { "ext": "ts", "name": "MPEG-TS Video", "role": "Viewer" },
        { "ext": "mts", "name": "AVCHD Video", "role": "Viewer" },
        { "ext": "m2ts", "name": "AVCHD Video", "role": "Viewer" },
        { "ext": "mpg", "name": "MPEG Video", "role": "Viewer" },
        { "ext": "mpeg", "name": "MPEG Video", "role": "Viewer" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "allowScripts": {
    "electron@44.7.1": true,
    "ffmpeg-static@5.3.0": true
  }
}
